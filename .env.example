# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the Qwen key.
# The DATA layer works with no keys; the ANALYSIS layer needs Qwen.
# ─────────────────────────────────────────────────────────────

# Bitget MCP data server (US stocks / ETF). No API key required.
BITGET_MCP_URL=https://agent.bitget.com/mcp

# SEC EDGAR (keyless fallback) asks for a descriptive User-Agent + contact.
SEC_USER_AGENT=Decision Stress-Tester (your-email@example.com)

# ─────────────────────────────────────────────────────────────
# Qwen (LLM) — REQUIRED for the analysis layer.
# Qwen exposes an OpenAI-compatible endpoint; we use the OpenAI SDK.
#
# Option A (default) — Bitget hackathon proxy (where your S2 credits live):
#   QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
#   QWEN_MODEL=qwen3.8-max
#
# Option B — Alibaba DashScope directly (Model Studio key):
#   QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # Singapore/intl
#   # or https://dashscope.aliyuncs.com/compatible-mode/v1                 # Beijing
#   # or https://dashscope-us.aliyuncs.com/compatible-mode/v1              # US-Virginia
#   QWEN_MODEL=qwen3.8-max            # or qwen-plus / qwen3-max
# ─────────────────────────────────────────────────────────────

# Your Qwen API key (also accepts DASHSCOPE_API_KEY or BITGET_QWEN_API_KEY).
QWEN_API_KEY=

# Optional overrides (defaults shown above).
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=qwen3.8-max
